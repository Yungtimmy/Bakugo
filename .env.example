# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (use @userinfobot to get it)
TELEGRAM_CHAT_ID=your_chat_id_here

# Solana RPC — use a private RPC for reliability (Helius, QuickNode, etc.)
SOLANA_RPC_URL=https://your-endpoint.solana-mainnet.quiknode.pro/your_api_key/

# Wallet private keys — base58 encoded (from Phantom: Settings > Export Private Key)
WALLET_PRIVATE_KEY_1=your_base58_private_key_here
WALLET_PRIVATE_KEY_2=
WALLET_PRIVATE_KEY_3=
